# live | demo | auto   (auto = try live sources, fall back to demo data per source)
FINN_MODE=auto

# Optional: any OpenAI-compatible endpoint. Groq free tier shown. Leave key empty = rules only.
FINN_LLM_BASE_URL=https://api.groq.com/openai/v1
FINN_LLM_API_KEY=
FINN_CHEAP_MODEL=llama-3.1-8b-instant
FINN_STRONG_MODEL=llama-3.3-70b-versatile

# Gemini alternative:
# FINN_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# FINN_CHEAP_MODEL=gemini-2.0-flash-lite
# FINN_STRONG_MODEL=gemini-2.5-flash

# Local alternative (Ollama, no key needed):
# FINN_LLM_BASE_URL=http://localhost:11434/v1
